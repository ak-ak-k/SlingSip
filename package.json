{
  "name": "slingsip-desktop-companion",
  "productName": "SlingSip",
  "version": "0.1.0",
  "description": "A playful desktop hydration companion.",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.mjs",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "npm run build && node scripts/start-electron.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "node scripts/prepare-slingsip-pngs.mjs && ng build --base-href ./",
    "build:electron": "node scripts/build-electron.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "npm run build && playwright test",
    "test:electron": "playwright test",
    "package:dir": "npm run build && node scripts/package-windows.mjs --preview",
    "package:win": "npm run build && node scripts/package-windows.mjs"
  },
  "dependencies": {
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "electron-store": "11.0.2",
    "electron-updater": "6.8.9",
    "js-yaml": "4.3.2",
    "rxjs": "7.8.2",
    "three": "0.186.1",
    "tslib": "2.8.1"
  },
  "overrides": {
    "@electron/get": {
      "global-agent": "4.1.3"
    }
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@playwright/test": "1.63.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.19.1",
    "@types/three": "0.186.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  }
}
